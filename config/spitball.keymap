#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
              &kp NUMBER_1  &kp NUMBER_2     &kp NUMBER_3  &kp NUMBER_4   &kp N5
&kp TAB       &kp Q         &kp W            &kp E         &kp R          &kp T
&kp ESCAPE    &kp A         &kp S            &kp D         &kp F          &kp G
&kp LCTRL     &kp Z         &kp X            &kp C         &kp V          &kp B
&kp LEFT_WIN  &kp LG(L)     &kp LG(TAB)      &mo 2         &mo 1          &kp LEFT_SHIFT
&kp NUMBER_6  &kp N7        &kp N8           &kp N9        &kp N0
&kp Y         &kp U         &kp I            &kp O         &kp P          &kp BACKSPACE
&kp H         &kp J         &kp K            &kp L         &kp SEMICOLON  &kp ENTER
&kp N         &kp M         &kp COMMA        &kp PERIOD    &kp SLASH      &kp RIGHT_ALT
&kp SPACE     &kp SQT       &kp PRINTSCREEN  &kp K_COPY    &kp K_PASTE    &kp LEFT_BRACE
&mkp LCLK
            >;
        };

        layer_1 {
            display-name = "Layer 1";
            bindings = <
                 &trans           &trans           &trans              &kp BACKSPACE  &kp ENTER
&kp CAPSLOCK     &trans           &kp UP_ARROW     &trans              &trans         &trans
&trans           &kp LEFT         &kp DOWN_ARROW   &kp RIGHT           &trans         &trans
&trans           &trans           &trans           &trans              &trans         &trans
&bt BT_SEL 0     &bt BT_SEL 1     &bt BT_CLR       &trans              &trans         &trans
&trans           &trans           &trans           &trans              &kp MINUS
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans              &trans         &kp EQUAL
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans              &trans         &trans
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans              &trans         &trans
&kp DEL          &kp KP_NUMBER_0  &kp KP_DOT       &kp KP_EQUAL_AS400  &trans         &kp RIGHT_BRACE
&mkp RCLK
            >;
        };

        layer_2 {
            display-name = "Scroll";
            bindings = <
           &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans
&mkp MCLK
            >;
        };
    };
};

/* Trackball becomes a scroll wheel while Layer 2 is active */
&trackball_listener {
    scroller {
        layers = <2>;
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};
